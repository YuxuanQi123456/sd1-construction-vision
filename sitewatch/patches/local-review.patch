+def owns_review_listener(pid, argv, proc_root=Path('/proc')):
+    """Bind the declared process to the exact loopback listening socket."""
+    def argument(name):
+        try:
+            return argv[argv.index(name.encode()) + 1]
+        except (ValueError, IndexError):
+            return None
