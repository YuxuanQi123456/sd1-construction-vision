+def _atomic(path, raw):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temp = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
+    try:
+        temp.write_bytes(raw)
+        temp.replace(path)
+    finally:
+        temp.unlink(missing_ok=True)
