+    clipped = [min(width, max(0, int(x1-dx))), min(height, max(0, int(y1-dy))),
+               min(width, max(0, int(x2+dx+1))), min(height, max(0, int(y2+dy+1)))]
+    if clipped[2] <= clipped[0] or clipped[3] <= clipped[1]:
+        raise ValueError('裁剪区域超出画面')
+    return clipped
