+        "对象": item.get("track_id", ""),
+        "开始（秒）": item.get("start_seconds"),
+        "结束（秒）": item.get("end_seconds"),
+        "持续（秒）": item.get("duration_seconds"),
+        "状态": "待人工确认" if item.get("status") == "pending" else item.get("status", ""),
+    } for item in events]
